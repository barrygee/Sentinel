.git
.gitignore
.github
.claude
*.md
# ...except the one the docs service serves on the in-app /docs page.
!CONTRIBUTING.md
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
backend/.venv
.venv
node_modules
**/node_modules
**/coverage
frontend/assets/tiles/
**/.ruff_cache
**/.pytest_cache
**/.mypy_cache
services/sections/*/backend/tests
services/radio/backend/tests
services/docs/backend/tests
services/sdr-manager-local/backend/tests
# Design notes: not part of the in-app docs.
docs/plans
# The native Mac SDR Manager's credentials (secrets) never go into an image.
sdr-manager-local-credentials
# Never bake an install's data or secrets into an image: databases (and their
# WAL/journal files), environment files and the live config file (every
# setting of the install it came from).
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
# `**/` matches zero or more folders, so these cover the root's own .env too.
**/.env
**/.env.*
**/sentinel_config.json
config
