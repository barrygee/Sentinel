                "/api/auth/login",
                "/api/auth/password"
            ],
            "methods": ["POST"],
            "access": ["browser", "peer", "internal"],
            "group": "console_login"
        },
        {
            "note": "SDR Manager (this machine): its event stream.",
            "profiles": ["sdr_manager_local"],
            "paths": ["/api/sdr-manager/local/events", "/api/events"],
            "methods": ["GET"],
            "access": ["browser", "peer", "internal"],
            "group": "streams"
        },
        {
            "note": "SDR Manager (this machine): importing a config.",
            "profiles": ["sdr_manager_local"],
            "paths": ["/api/sdr-manager/local/config", "/api/config"],
            "methods": ["POST"],
            "access": ["browser", "peer", "internal"],
            "group": "data_file_upload"
        },
        {
            "note": "SDR Manager (this machine): signing out, managing devices, reservations and the hotspot.",
            "profiles": ["sdr_manager_local"],
            "paths": ["/api/sdr-manager/local/**", "/api/**"],
            "methods": ["POST", "PUT", "PATCH", "DELETE"],
            "access": ["browser", "peer", "internal"],
