{
  "name": "sentinel-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <26.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && npm run build:sections",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:sections": "bash ../../scripts/web-packages.sh build"
  },
  "dependencies": {
    "@module-federation/runtime": "2.9.2",
    "@sentinel/map-kit": "*",
    "@sentinel/section-air": "*",
    "@sentinel/section-land": "*",
    "@sentinel/section-sdr": "*",
    "@sentinel/section-sea": "*",
    "@sentinel/section-space": "*",
    "@sentinel/shell-api": "*",
    "@sentinel/ui": "*",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^6.10.0",
    "pinia": "^2.2.0",
    "pmtiles": "^3.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "1.23.2",
    "@playwright/test": "^1.60.0",
    "@sentinel/web-config": "*",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "jest-axe": "^10.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "prettier": "@sentinel/web-config/prettier"
}
