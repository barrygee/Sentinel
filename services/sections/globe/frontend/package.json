{
  "name": "@sentinel/section-globe",
  "private": true,
  "version": "0.0.0",
  "description": "The optional GLOBE section of Sentinel: a 3D globe of live aircraft, satellites, vessels and APRS stations, off until Settings › App Settings › 3D Globe is on.",
  "type": "module",
  "exports": {
    "./*.vue": "./src/*.vue",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": "@sentinel/web-config/prettier",
  "dependencies": {
    "@sentinel/shell-api": "*",
    "@sentinel/ui": "*",
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@sentinel/web-config": "*",
    "@types/three": "^0.187.0"
  }
}
