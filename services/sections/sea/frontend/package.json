{
  "name": "@sentinel/section-sea",
  "private": true,
  "version": "0.0.0",
  "description": "The Sea (AIS) section of Sentinel: its views, map controls, stores, settings and registration with the shell.",
  "type": "module",
  "exports": {
    "./*.vue": "./src/*.vue",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": "@sentinel/web-config/prettier",
  "dependencies": {
    "@sentinel/map-kit": "*",
    "@sentinel/shell-api": "*",
    "@sentinel/ui": "*"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.10.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@sentinel/web-config": "*"
  }
}
