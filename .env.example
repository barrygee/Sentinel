# Sentinel environment configuration — copy to `.env` (git-ignored) and edit.
# Every variable that has a default is set to it below, so this file runs as is;
# change only what differs on this machine. The few left commented out have no
# default (they are needed only on a radio host). After a change, run
# `docker compose up -d` (it recreates only the containers the change affects).
# Full guide: docs/configuration.md.
#
# Docker Compose passes only the variables listed here to the containers.
# The other backend settings in backend/config.py (cache times, timeouts,
# upstream addresses) do nothing in this file: set one on the service that uses
# it in a docker-compose.override.yml instead (see docs/configuration.md).
#
# Service and decoder credentials need NO configuration: on every `up` the
# one-shot `service-credentials` service gives each service and each decoder
# its own token for Sentinel's internal routes (and each service its NATS
# user), kept on the service_credentials volume.

# ── What starts ───────────────────────────────────────────────────────────────

# Which optional decoders start with a plain `docker compose up`. Read by Docker
# Compose itself; the same as passing --profile on every command (including
# `down` and `logs`). Empty, no decoder starts; the sections always start.
#   all          every decoder (voice, APRS, AIS, ADS-B)
#   aprs,ais     a list of profiles: voice-decoder, aprs, ais, adsb
# Each decoder needs its OWN dongle; they cannot share one receiver.
COMPOSE_PROFILES=

# How many radio hubs this machine starts: 1 (the default) or 0. Set 0 only when
# the hub runs on a second machine instead (compose.radio-host.yaml,
# docs/radio-host.md). To leave a section out, use
# `docker compose up -d --scale <service>=0` rather than a variable.
SENTINEL_RADIO_REPLICAS=1

# Whether this machine starts the in-app docs service (/docs): 1 (the default)
# or 0. With 0 the app runs without Docs — no Docs entry in the Settings rail
# and no LEARN MORE links. `docker compose up -d --scale docs=0` does the same
# for one run.
SENTINEL_DOCS_REPLICAS=1

# ── Where files go ────────────────────────────────────────────────────────────

# A folder on this machine for SDR recordings (each one's WAV and raw IQ),
# mounted into the sdr service as /recordings. Set it to open the files in other
# software, keep them on a bigger disk or back them up, e.g. ~/SentinelRecordings.
# The default, sdr_recordings, is a Docker volume, reachable only through the
# app. Settings › SDR › Recordings Folder picks a subfolder inside it. After
# changing it, run `docker compose up -d sdr`.
SENTINEL_RECORDINGS_DIRECTORY=sdr_recordings

# The user id the app and every service container run as (never root: the
# entrypoint hands the data volumes to this user on start). The default, 1000,
# suits Docker Desktop and most Linux desktops. On Linux, if `id -u` isn't 1000,
# set it to yours, or the app can't write sentinel_config.json into ./backend and
# recordings belong to someone else.
SENTINEL_RUNTIME_USER_ID=1000

# The group id to match SENTINEL_RUNTIME_USER_ID: your `id -g` on Linux.
SENTINEL_RUNTIME_GROUP_ID=1000

# ── Data sources ──────────────────────────────────────────────────────────────

# Your AISStream.io key, for live ships online (https://aisstream.io, free).
# Used only server-side. A key entered in Settings › SEA › AIS Data API Key wins
# over this one. AISStream allows ONE connection per key, so don't use the same
# key in two Sentinels. Empty: no key here.
AISSTREAM_API_KEY=

# Where Off Grid AIR reads decoded aircraft. Defaults to this machine's
# `adsb-decoder` container; set it only when the ADS-B decoder runs elsewhere,
# e.g. http://<decoder-host>:8090/data/aircraft.json.
ADSB_OFFGRID_URL=http://adsb-decoder:8080/data/aircraft.json

# The basemap archive offline map downloads are cut from (Settings › App
# Settings › Offline Maps). Leave unset: the newest Protomaps Basemap v4 planet
# build is found automatically (Protomaps deletes each dated build after about a
# week, so a fixed address would stop working). Set it only to force one build,
# e.g. a self-hosted copy.
OFFLINE_BASEMAP_SOURCE_URL=

# The terrain archive offline Terrain downloads are cut from: Mapterhorn's
# whole-planet Terrarium DEM (z0-12), the source of the bundled
# uk-terrain.pmtiles. Change it only to use another Terrarium-format archive.
OFFLINE_TERRAIN_SOURCE_URL=https://download.mapterhorn.com/planet.pmtiles

# ── The ADS-B decoder (only with the `adsb` profile) ──────────────────────────

# Where the adsb-decoder's aircraft.json is published on this machine. The
# default, 127.0.0.1:8090, is this machine only; 0.0.0.0:8090 opens it to the
# LAN for another machine reading it as ADSB_OFFGRID_URL. It has no password.
SENTINEL_ADSB_DECODER_ADDRESS=127.0.0.1:8090

# Your Sentry host's API. At start the decoder asks it what the dongle is tuned
# to and logs the answer, so a mis-tuned dongle shows in the log rather than as
# an empty map, e.g. http://<sentry-host>:8000. Empty skips the check.
SENTINEL_ADSB_SENTRY_API=

# A fixed rtl_tcp address for the decoder to read, used only when no dongle is
# chosen in Settings › AIR › Off Grid ADS-B SDR (or when running the decoder
# standalone), e.g. 192.168.1.20. Normally leave empty: the decoder asks
# Sentinel which dongle to use.
SENTINEL_ADSB_RTL_TCP_HOST=

# The port for SENTINEL_ADSB_RTL_TCP_HOST. Default 2345.
SENTINEL_ADSB_RTL_TCP_PORT=2345

# ── Decoders outside this Docker network ──────────────────────────────────────

# Where every decoder reaches Sentinel's gateway; they reach the radio hub
# through it, so they find it wherever it runs. Keep the default on the compose
# network; set it for a decoder running elsewhere: http://<sentinel-host>:8080.
# (A radio host sets its own in compose.radio-host.yaml; this is not read there.)
SENTINEL_GATEWAY_URL=http://gateway:8080

# ── A second machine (radio host) — see docs/radio-host.md ────────────────────
# Set these on the CORE host (the machine running the app):

# Names or IP addresses the radio host reaches this machine by, comma-separated.
# The event bus's and the TLS service entrypoint's certificates cover them,
# e.g. sentinel.lan,192.168.1.10. Empty: no radio host.
SENTINEL_CORE_HOSTNAMES=

# Names or IP addresses this machine reaches the radio host by. Sentinel issues
# the radio host gateway's certificate for them and exports it with the radio
# host's credentials, e.g. radio.lan. Empty: no radio host.
SENTINEL_RADIO_HOST_HOSTNAMES=

# Where the TLS service entrypoint (:8443) is published. The default,
# 127.0.0.1:8443, is this machine only; 0.0.0.0:8443 opens it to a radio host.
SENTINEL_SERVICE_ENTRYPOINT_ADDRESS=127.0.0.1:8443

# Where the event bus (NATS, :4222) is published. The default, 127.0.0.1:4222,
# is this machine only; 0.0.0.0:4222 opens it to a radio host.
NATS_PUBLISHED_ADDRESS=127.0.0.1:4222

# Set these on the RADIO host (compose.radio-host.yaml). The first three have
# no default: compose there refuses to start until they are set.

# The core host's TLS service entrypoint, which the radio hub registers with and
# reads its settings through.
# SENTINEL_CORE_ENTRYPOINT_URL=https://sentinel.lan:8443

# The core host's event bus.
# SENTINEL_CORE_NATS_URL=tls://sentinel.lan:4222

# The address the core host reaches this radio host's gateway on; the hub
# registers it as its own address.
# SENTINEL_RADIO_HOST_URL=https://radio.lan:8443

# Where this radio host publishes its gateway. Default 8443, on every interface.
SENTINEL_RADIO_HOST_GATEWAY_ADDRESS=8443

# ── Leave these alone ─────────────────────────────────────────────────────────

# The event bus address. Compose sets it to the bundled `nats` service over TLS
# (tls://nats:4222), each process signing in as its own NATS user. Changing it
# disconnects the services from each other.
NATS_URL=tls://nats:4222
