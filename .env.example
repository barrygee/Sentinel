# Sentinel environment configuration — copy to `.env` (git-ignored) and edit.
# Every variable that has a default is set to it below, so this file runs as is;
# change only what differs on this machine. The few left commented out have no
# default (they are needed only on a radio host). After a change, run
# `docker compose up -d` (it recreates only the containers the change affects).
# Full guide: docs/configuration.md.
#
# Docker Compose passes only the variables listed here to the containers.
# The other backend settings in backend/config.py (cache times, timeouts,
# upstream addresses) do nothing in this file: set one on the service that uses
# it in a docker-compose.override.yml instead (see docs/configuration.md).
#
# Service and decoder credentials need NO configuration: on every `up` the
# one-shot `service-credentials` service gives each service and each decoder
# its own token for Sentinel's internal routes (and each service its NATS
# user), kept on the service_credentials volume.

# ── Choose your setup ─────────────────────────────────────────────────────────
# Pick ONE recipe, set its lines below, then run `docker compose up -d`.
#  1. Sentinel — manage SDRs on other machines only ........ change nothing
#  2. Sentinel + SDRs plugged into this Linux computer ..... COMPOSE_PROFILES=sdr-manager-local
#  3. SDR Manager only, lightweight (Linux / Raspberry Pi) . COMPOSE_FILE=compose.sdr-manager-local-only.yaml
#                                                            COMPOSE_PROFILES=sdr-manager-local
#  4. Sentinel + SDRs plugged into this Mac ................ SDR_MANAGER_LOCAL_NATIVE=1
#  5. SDR Manager only, lightweight, on a Mac .............. COMPOSE_FILE=compose.sdr-manager-local-only.yaml
#                                                            SDR_MANAGER_LOCAL_NATIVE=1
# On a Mac (4, 5) also run `uv run --project backend sdr-manager-local install`
# once, after `docker compose up -d`: docs/sdr-manager-mac.md walks you through
# it. Linux and Pi: docs/sdr-manager-linux.md. Recipes 3 and 5:
# docs/sdr-manager-local-only.md.

# ── What starts ───────────────────────────────────────────────────────────────

# Which compose file Docker Compose reads (read by Docker Compose itself, like
# COMPOSE_PROFILES). Leave it commented out for the full app
# (docker-compose.yml).
#   compose.sdr-manager-local-only.yaml   SDR Manager only (recipes 3 and 5): no
#                                         map and no sections, just this
#                                         machine's SDRs, shared with other
#                                         Sentinels
# Switching between the two keeps your settings; run
# `docker compose up -d --remove-orphans` after changing it, so the other
# file's containers stop.
# COMPOSE_FILE=compose.sdr-manager-local-only.yaml

# Which optional services start with a plain `docker compose up`. Read by Docker
# Compose itself; the same as passing --profile on every command (including
# `down` and `logs`). Empty, no decoder starts; the sections always start.
#   all          every decoder (voice, APRS, AIS, ADS-B)
#   aprs,ais     a list of profiles: voice-decoder, aprs, ais, adsb
#   sdr-manager-local   manage SDRs plugged into this computer, in a container —
#                       Linux only (not part of `all`; recipes 2 and 3);
#                       combine with decoders, e.g. sdr-manager-local,adsb
# Each decoder needs its OWN dongle; they cannot share one receiver.
COMPOSE_PROFILES=

# Mac only (recipes 4 and 5): manage the SDRs plugged into this Mac with a
# native Mac process instead of a container (Docker Desktop can't pass USB
# through). After setting it, run `docker compose up -d`, then
# `uv run --project backend sdr-manager-local install` once.
#   0  off (default)
#   1  on — also writes its sign-in files to ./sdr-manager-local-credentials
SDR_MANAGER_LOCAL_NATIVE=0

# How many radio hubs this machine starts: 1 (the default) or 0. Set 0 only when
# the hub runs on a second machine instead (compose.radio-host.yaml,
# docs/radio-host.md). To leave a section out, use
# `docker compose up -d --scale <service>=0` rather than a variable.
SENTINEL_RADIO_REPLICAS=1

# Whether this machine starts the in-app docs service (/docs): 1 (the default)
# or 0. With 0 the app runs without Docs — no Docs entry in the Settings rail
# and no LEARN MORE links. `docker compose up -d --scale docs=0` does the same
# for one run.
SENTINEL_DOCS_REPLICAS=1

# ── Where files go ────────────────────────────────────────────────────────────

# A folder on this machine for SDR recordings (each one's WAV and raw IQ),
# mounted into the sdr service as /recordings. Set it to open the files in other
# software, keep them on a bigger disk or back them up, e.g. ~/SentinelRecordings.
# The default, sdr_recordings, is a Docker volume, reachable only through the
# app. Settings › SDR › Recordings Folder picks a subfolder inside it. After
# changing it, run `docker compose up -d sdr`.
SENTINEL_RECORDINGS_DIRECTORY=sdr_recordings

# The user id the app and every service container run as (never root: the
# entrypoint hands the data volumes to this user on start). The default, 1000,
# suits Docker Desktop and most Linux desktops. On Linux, if `id -u` isn't 1000,
# set it to yours, or the app can't write sentinel_config.json into ./backend and
# recordings belong to someone else.
SENTINEL_RUNTIME_USER_ID=1000

# The group id to match SENTINEL_RUNTIME_USER_ID: your `id -g` on Linux.
SENTINEL_RUNTIME_GROUP_ID=1000

# ── Data sources ──────────────────────────────────────────────────────────────

# Your AISStream.io key, for live ships online (https://aisstream.io, free).
# Used only server-side. A key entered in Settings › SEA › AIS Data API Key wins
# over this one. AISStream allows ONE connection per key, so don't use the same
# key in two Sentinels. Empty: no key here.
AISSTREAM_API_KEY=

# Where Off Grid AIR reads decoded aircraft. Defaults to this machine's
# `adsb-decoder` container; set it only when the ADS-B decoder runs elsewhere,
# e.g. http://<decoder-host>:8090/data/aircraft.json.
ADSB_OFFGRID_URL=http://adsb-decoder:8080/data/aircraft.json

# The basemap archive offline map downloads are cut from (Settings › App
# Settings › Offline Maps). Leave unset: the newest Protomaps Basemap v4 planet
# build is found automatically (Protomaps deletes each dated build after about a
# week, so a fixed address would stop working). Set it only to force one build,
# e.g. a self-hosted copy.
OFFLINE_BASEMAP_SOURCE_URL=

# The terrain archive offline Terrain downloads are cut from: Mapterhorn's
# whole-planet Terrarium DEM (z0-12), the source of the bundled
# uk-terrain.pmtiles. Change it only to use another Terrarium-format archive.
OFFLINE_TERRAIN_SOURCE_URL=https://download.mapterhorn.com/planet.pmtiles

# ── The ADS-B decoder (only with the `adsb` profile) ──────────────────────────

# Where the adsb-decoder's aircraft.json is published on this machine. The
# default, 127.0.0.1:8090, is this machine only; 0.0.0.0:8090 opens it to the
# LAN for another machine reading it as ADSB_OFFGRID_URL. It has no password.
SENTINEL_ADSB_DECODER_ADDRESS=127.0.0.1:8090

# Your SDR host's API. At start the decoder asks it what the dongle is tuned
# to and logs the answer, so a mis-tuned dongle shows in the log rather than as
# an empty map, e.g. http://<sdr-manager-host>:8000. Empty skips the check.
SENTINEL_ADSB_SDR_MANAGER_API=

# A fixed rtl_tcp address for the decoder to read, used only when no dongle is
# chosen in Settings › AIR › Off Grid ADS-B SDR (or when running the decoder
# standalone), e.g. 192.168.1.20. Normally leave empty: the decoder asks
# Sentinel which dongle to use.
SENTINEL_ADSB_RTL_TCP_HOST=

# The port for SENTINEL_ADSB_RTL_TCP_HOST. Default 2345.
SENTINEL_ADSB_RTL_TCP_PORT=2345

# ── Decoders outside this Docker network ──────────────────────────────────────

# Where every decoder reaches Sentinel's gateway; they reach the radio hub
# through it, so they find it wherever it runs. Keep the default on the compose
# network; set it for a decoder running elsewhere: http://<sentinel-host>:8080.
# (A radio host sets its own in compose.radio-host.yaml; this is not read there.)
SENTINEL_GATEWAY_URL=http://gateway:8080

# ── A second machine (radio host) — see docs/radio-host.md ────────────────────
# Set these on the CORE host (the machine running the app):

# Names or IP addresses the radio host reaches this machine by, comma-separated.
# The event bus's and the TLS service entrypoint's certificates cover them,
# e.g. sentinel.lan,192.168.1.10. Empty: no radio host.
SENTINEL_CORE_HOSTNAMES=

# Names or IP addresses this machine reaches the radio host by. Sentinel issues
# the radio host gateway's certificate for them and exports it with the radio
# host's credentials, e.g. radio.lan. Empty: no radio host.
SENTINEL_RADIO_HOST_HOSTNAMES=

# Where the TLS service entrypoint (:8443) is published. The default,
# 127.0.0.1:8443, is this machine only; 0.0.0.0:8443 opens it to a radio host.
SENTINEL_SERVICE_ENTRYPOINT_ADDRESS=127.0.0.1:8443

# Where the event bus (NATS, :4222) is published. The default, 127.0.0.1:4222,
# is this machine only; 0.0.0.0:4222 opens it to a radio host.
NATS_PUBLISHED_ADDRESS=127.0.0.1:4222

# Set these on the RADIO host (compose.radio-host.yaml). The first three have
# no default: compose there refuses to start until they are set.

# The core host's TLS service entrypoint, which the radio hub registers with and
# reads its settings through.
# SENTINEL_CORE_ENTRYPOINT_URL=https://sentinel.lan:8443

# The core host's event bus.
# SENTINEL_CORE_NATS_URL=tls://sentinel.lan:4222

# The address the core host reaches this radio host's gateway on; the hub
# registers it as its own address.
# SENTINEL_RADIO_HOST_URL=https://radio.lan:8443

# Where this radio host publishes its gateway. Default 8443, on every interface.
SENTINEL_RADIO_HOST_GATEWAY_ADDRESS=8443

# ── SDR Manager: this machine's SDRs (sdr-manager-local) ──────────────────────
# Read only when SDR Manager for this machine runs: recipes 2–5 (the
# `sdr-manager-local` profile, or SDR_MANAGER_LOCAL_NATIVE=1 on a Mac). Every
# value below is the default. After a change, run `docker compose up -d` (Linux)
# or `uv run --project backend sdr-manager-local install` again (Mac).

# Network

# The port SDR Manager listens on — for this Sentinel AND for other Sentinels
# using or managing this machine's SDRs (they add it as <this machine>:8000).
# Change it only if 8000 is taken (`sdr-manager-local doctor` says so on a Mac).
SDR_MANAGER_LOCAL_HTTP_PORT=8000

# The address it listens on. 0.0.0.0 (every network) lets other Sentinels reach
# it; 127.0.0.1 keeps other machines out (they then can't use its SDRs, and
# this Sentinel's containers may not reach it either).
SDR_MANAGER_LOCAL_HTTP_HOST=0.0.0.0

# The host name or IP address other programs are told to stream each SDR from
# (rtl_tcp). Unset, it is the address they asked SDR Manager on, which is right
# almost always. Set it when that address doesn't work from where they are,
# e.g. decoders that can't resolve host.docker.internal, or a fixed LAN name.
# SDR_MANAGER_LOCAL_ADVERTISED_HOST=192.168.1.20

# Browser origins allowed to call the API from another site, comma-separated.
# Empty (the default) allows none, which is right: Sentinel's pages come from
# the same address. Only for developing a separately hosted page.
SDR_MANAGER_LOCAL_CORS_ORIGINS=

# Devices

# The most SDRs it runs at once, 1–64. Each one takes about 33 Mbps of USB and
# network bandwidth.
SDR_MANAGER_LOCAL_MAX_DEVICES=8

# The first of the ports kept for each SDR's internal rtl_tcp, on this machine
# only: SDR_MANAGER_LOCAL_INTERNAL_PORT_BASE up to that plus MAX_DEVICES - 1.
# Change it only if something else uses 14000–14007.
SDR_MANAGER_LOCAL_INTERNAL_PORT_BASE=14000

# Ports never given to an SDR, comma-separated, e.g. 1234,5000. Empty: none
# beyond the ones SDR Manager already avoids (its own port and ports in use).
SDR_MANAGER_LOCAL_RESERVED_PORTS=

# Seconds between checks for SDRs plugged in or unplugged. A safety net on
# Linux (plugging is noticed at once); the only check on a Mac.
SDR_MANAGER_LOCAL_RECONCILE_INTERVAL_S=2.0

# real drives the SDRs plugged into this machine; fake simulates two, to try it
# without hardware (compose.sdr-manager-local-mock.yaml sets it for you).
SDR_MANAGER_LOCAL_HARDWARE=real

# Seconds between reads of Sentinel's Location setting (Settings › App Settings
# › Sentinel Location), which SDR Manager reports to other Sentinels. 5–3600.
SDR_MANAGER_LOCAL_LOCATION_REFRESH_S=60

# How much it logs: DEBUG, INFO, WARNING or ERROR.
SDR_MANAGER_LOCAL_LOG_LEVEL=INFO

# Paths (leave alone unless a program is somewhere unusual)

# The rtl_tcp and rtl_eeprom programs. The container has its own; a Mac uses
# Homebrew's (brew install librtlsdr), found on PATH or in Homebrew's folders.
SDR_MANAGER_LOCAL_RTL_TCP_PATH=rtl_tcp
SDR_MANAGER_LOCAL_RTL_EEPROM_PATH=rtl_eeprom

# The librtlsdr library file. Unset searches the usual places (on a Mac,
# Homebrew's /opt/homebrew/lib and /usr/local/lib).
# SDR_MANAGER_LOCAL_LIBRTLSDR_PATH=/opt/homebrew/lib/librtlsdr.dylib

# Where Linux lists USB devices. Only tests change it.
SDR_MANAGER_LOCAL_SYSFS_ROOT=/sys

# The relay that lets several programs share one SDR. It ships inside SDR
# Manager and must stay there; only tests change it.
# SDR_MANAGER_LOCAL_RELAY_PATH=

# Wi-Fi hotspot (Linux with NetworkManager only; a Mac has none)

# true lets SDR Manager change this machine's Wi-Fi, and can't be switched off
# in Settings › SDR Manager › Hotspot › ALLOW CHANGES. false (the default)
# leaves that choice to the switch in Settings.
SDR_MANAGER_LOCAL_HOTSPOT_CONTROL_ENABLED=false

# true (the default) refuses every hotspot change until a console password is
# set: an open hotspot puts anyone who joins one step from your SDRs.
SDR_MANAGER_LOCAL_HOTSPOT_REQUIRE_AUTH_TOKEN=true

# The name of the one NetworkManager connection SDR Manager creates and changes;
# it never touches any other. Letters, digits, - and _, up to 32.
SDR_MANAGER_LOCAL_HOTSPOT_CONNECTION_NAME=sdr-manager-hotspot

# The Wi-Fi interface for the hotspot, e.g. wlan0. Unset picks an unused one.
# SDR_MANAGER_LOCAL_HOTSPOT_INTERFACE=wlan0

# This machine's address on the hotspot network, with its size. A phone or
# laptop that joins reaches Sentinel at that address (10.42.0.1:8080).
SDR_MANAGER_LOCAL_HOTSPOT_GATEWAY_CIDR=10.42.0.1/24

# Seconds you have to confirm a new hotspot works before it is undone, 15–900.
SDR_MANAGER_LOCAL_HOTSPOT_CONFIRM_TIMEOUT_S=120

# The nmcli program, how long one nmcli command may take (seconds, up to 120),
# and where NetworkManager keeps who joined. Leave alone.
SDR_MANAGER_LOCAL_NMCLI_PATH=nmcli
SDR_MANAGER_LOCAL_NMCLI_TIMEOUT_S=20
SDR_MANAGER_LOCAL_NM_STATE_ROOT=/var/lib/NetworkManager

# ── SDR Manager: SDRs on other machines (sdr-manager-remote) ──────────────────
# Advanced: the defaults suit a home network. They take effect after
# `docker compose up -d sdr-manager-remote`. Not used in SDR Manager-only mode.

# Seconds between status checks of each remote SDR host.
# SDR_MANAGER_REMOTE_POLL_INTERVAL_S=2

# After a failed check, wait this long, doubling each time up to the maximum,
# so a host that's switched off is still retried now and then.
# SDR_MANAGER_REMOTE_POLL_BACKOFF_START_S=2
# SDR_MANAGER_REMOTE_POLL_BACKOFF_MAX_S=30

# Seconds between reads of each host's position (shown on the maps).
# SDR_MANAGER_REMOTE_LOCATION_REFRESH_S=60

# How long a call to a host may take to connect, and then to answer (seconds).
# Raise them for a slow link such as a long Wi-Fi hop.
# SDR_MANAGER_REMOTE_CONNECT_TIMEOUT_S=3
# SDR_MANAGER_REMOTE_READ_TIMEOUT_S=5

# Seconds between checks for this machine's SDR Manager, which is listed first
# under REMOTE SDR HOSTS as "This machine".
# SDR_MANAGER_REMOTE_LOCAL_LINK_INTERVAL_S=10

# ── Leave these alone ─────────────────────────────────────────────────────────

# The event bus address. Compose sets it to the bundled `nats` service over TLS
# (tls://nats:4222), each process signing in as its own NATS user. Changing it
# disconnects the services from each other.
NATS_URL=tls://nats:4222
