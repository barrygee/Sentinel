# Sentinel environment configuration — copy to `.env` (git-ignored) and fill in.
# Only non-default / deployment-specific values need to be set; everything here
# has a working default in backend/config.py.
#
# Service and decoder credentials need NO configuration: on every `up` the
# one-shot `service-credentials` service gives each service and each decoder
# sidecar its own token for Sentinel's internal routes (and each service its
# NATS user), kept on the service_credentials volume.

# Which optional decoder sidecars start with a bare `docker compose up`.
# They are opt-in profiles, so by default `docker compose up` starts only the
# app. Setting this is the same as passing --profile on every command:
#   all                     every decoder (voice, APRS, AIS, ADS-B)
#   aprs,ais                just those two
#   space,land,air,sea      those sections in their own containers (not decoders)
# Each decoder needs its OWN dongle — they cannot share one receiver.
# COMPOSE_PROFILES=all

# Air domain — where Off Grid AIR reads decoded aircraft. Defaults to the compose
# `adsb-decoder` sidecar; set this only when the decoder runs elsewhere.
# ADSB_OFFGRID_URL=http://adsb-decoder:8080/data/aircraft.json

# Sea domain — live vessels from AISStream.io (https://aisstream.io, free key).
# The key is only ever used server-side; it can also be entered in Settings › SEA,
# which takes precedence over this value. AISStream allows ONE connection per key,
# so don't run two Sentinel backends against the same key.
# AISSTREAM_API_KEY=

# Offline map downloads — user-selected region extracts (basemap + terrain).
# Empty OFFLINE_TILES_DIR means "next to the database file" (in Docker that's
# the existing sentinel_db volume at /app/data/tiles — no new volume needed).
# OFFLINE_TILES_DIR=

# Leave unset: the newest Protomaps Basemap v4 planet build is found
# automatically (Protomaps deletes each dated build after about a week, so a
# fixed address would stop working). Set it only to force a specific build,
# e.g. a self-hosted copy.
# OFFLINE_BASEMAP_SOURCE_URL=

# Mapterhorn's whole-planet Terrarium DEM archive (z0-12) — same source the
# bundled uk-terrain.pmtiles was built from. Rarely needs changing.
# OFFLINE_TERRAIN_SOURCE_URL=https://download.mapterhorn.com/planet.pmtiles

# Path/name of the go-pmtiles binary. The Docker image installs a pinned
# release onto PATH; only set this for local, non-Docker dev if `pmtiles` (the
# go-pmtiles CLI, NOT the Python `pmtiles` package) isn't already on PATH.
# PMTILES_BIN=pmtiles

# Sections that run in their own containers instead of inside the app
# (section-containers plan P6). Start one with its compose profile, e.g.
#   docker compose --profile space up -d
# — it takes its section over from the app on its own. Listing it here as well
# stops the app hosting its own copy at all, so stopping the container removes
# the section rather than leaving the app's stale copy behind. Supported: space, land, air, sea,
# radio-hub, sdr. Moving `sdr` out moves its recordings onto its own volume too;
# the radio hub follows this list to write IQ captures there, nothing else to set.
# SENTINEL_EXTERNAL_SERVICES=space

# Where the decoder sidecars (voice, APRS, AIS, ADS-B, stub) reach Sentinel's
# gateway. They talk to the radio hub through it, so it finds the hub wherever
# it runs, and each config reply names the hub's PCM socket. Leave unset on the
# compose network; set it for a decoder running outside it (e.g. on another
# host: http://<sentinel-host>:8080). Read by docker compose only, not by the app.
# SENTINEL_GATEWAY_URL=http://gateway:8080

# The unprivileged user the app and service containers run as (their process
# never runs as root; the entrypoint hands the data volumes to this user on
# start). The default, 1000, suits Docker Desktop and most Linux desktops. On a
# Linux host whose checkout is owned by another user, set both to `id -u` /
# `id -g`: the app writes sentinel_config.json into the bind-mounted ./backend.
# Read by docker compose only.
# SENTINEL_RUNTIME_USER_ID=1000
# SENTINEL_RUNTIME_GROUP_ID=1000

# NATS server the event bus forwards events to when sections run in separate
# containers (section-containers plan §3.3). Leave empty for the all-in-one app:
# events stay in-process. docker compose sets it to the bundled `nats` service
# over TLS (tls://nats:4222), with each process signing in as its own NATS user
# from the `service-credentials` output — nothing to configure.
# NATS_URL=nats://localhost:4222

# Extra host names the bus broker's TLS certificate must cover, comma-separated,
# when a second host dials it by another address. Read by docker compose only.
# NATS_SERVER_EXTRA_HOSTNAMES=sentinel.lan
