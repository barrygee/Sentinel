{
    "name": "sentinel",
    "private": true,
    "workspaces": [
        "frontend/vue",
        "platform/web/*",
        "services/sections/*/frontend"
    ],
    "engines": {
        "node": ">=24.0.0 <26.0.0",
        "npm": ">=11.0.0 <12.0.0"
    },
    "scripts": {
        "build:spa": "npm run build --prefix frontend/vue",
        "typecheck": "tsc --noEmit",
        "check:doc-links": "node scripts/check-doc-links.mts",
        "test:e2e:gateway": "SENTINEL_E2E_BASE_URL=${SENTINEL_E2E_BASE_URL:-http://localhost:8080} playwright test -c playwright.fullstack.config.ts",
        "lint": "eslint . && prettier --check \"tests/**/*.ts\" \"scripts/**/*.{ts,mts}\" \"*.{js,ts}\"",
        "lint:fix": "eslint . --fix && prettier --write \"tests/**/*.ts\" \"scripts/**/*.{ts,mts}\" \"*.{js,ts}\"",
        "format": "prettier --write \"tests/**/*.ts\" \"scripts/**/*.{ts,mts}\" \"*.{js,ts}\"",
        "format:check": "prettier --check \"tests/**/*.ts\" \"scripts/**/*.{ts,mts}\" \"*.{js,ts}\"",
        "prepare": "husky",
        "web-packages": "bash scripts/web-packages.sh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@types/node": "^24.13.3",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.3",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.61.0"
    },
    "overrides": {
        "undici": "^7.29.0",
        "vue": "^3.5.44",
        "mermaid": {
            "katex": "^0.18.2"
        },
        "monaco-editor": {
            "dompurify": "^3.4.16"
        },
        "sigplot": {
            "budo": "npm:empty-npm-package@1.0.0",
            "travis": "npm:empty-npm-package@1.0.0"
        }
    }
}
