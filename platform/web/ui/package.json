{
  "name": "@sentinel/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Sentinel's shared UI primitives: base components, generic icons and DOM composables. Depends on nothing but Vue.",
  "type": "module",
  "exports": {
    "./base/*": "./src/base/*",
    "./icons/*": "./src/icons/*",
    "./overlays/*": "./src/overlays/*",
    "./composables/*": "./src/composables/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": "@sentinel/web-config/prettier",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@sentinel/web-config": "*"
  }
}
