{
  // Compiler settings shared by the SPA and every @sentinel/* web package, so a
  // package type-checks under exactly the rules the app builds with.
  "compilerOptions": {
    // ES2022 baseline: the app relies on ES2022 library features (Array.prototype.at)
    // and Vite's default build target covers them.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  }
}
